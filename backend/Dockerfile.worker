# ============================================================================
# BUILDER STAGE - Install dependencies and compile bytecode
# ============================================================================
FROM python:3.13-slim-trixie AS builder

# Install minimal build dependencies in single layer with aggressive cleanup
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /var/cache/apt/archives/*

# Download and install uv package manager
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh

# Add uv to PATH
ENV PATH="/root/.local/bin/:$PATH"

WORKDIR /app

# Enable bytecode compilation for faster startup
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

# Copy and install worker-specific dependencies (minimal set)
COPY requirements.worker.txt .
RUN uv pip install --system --no-cache -r requirements.worker.txt && \
    find /usr/local -type f -name '*.pyc' -delete && \
    find /usr/local -type d -name '__pycache__' -delete

# Copy only required application files
COPY app/__init__.py          app/__init__.py
COPY app/core/config.py       app/core/config.py
COPY app/core/redis.py        app/core/redis.py
COPY app/models/__init__.py   app/models/__init__.py
COPY app/models/messages.py   app/models/messages.py
COPY app/services/__init__.py app/services/__init__.py
COPY app/services/transcript_state.py      app/services/transcript_state.py
COPY app/services/transcription_runner.py  app/services/transcription_runner.py
COPY app/services/transcript_cleanup.py    app/services/transcript_cleanup.py
COPY app/services/translation.py           app/services/translation.py
COPY worker_stt.py .
COPY worker_llm.py .
COPY .env .env

# ============================================================================
# RUNNER STAGE - Minimal runtime environment
# ============================================================================
FROM python:3.13-slim-trixie AS runner

# Install only runtime dependencies in single layer with cleanup
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /var/cache/apt/archives/*

# Create non-root user for security
RUN useradd -m -u 1000 worker

WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY --from=builder --chown=worker:worker /app /app

# Switch to non-root user
USER worker

# Workers don't expose ports, they process background jobs
# Health check for worker process
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import sys; sys.exit(0)" || exit 1

# Default command (can be overridden for STT or LLM worker)
CMD ["python", "worker_stt.py"]
